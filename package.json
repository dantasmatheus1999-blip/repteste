    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "firebase": "^12.10.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.546.0",
