rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "dantasmatheus1999@outlook.com.br");
    }

    // Biblioteca de Mapas do Mestre isolada estritamente por UID
    match /maps/{userId}/{allPaths=**} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    match /test_maps/{userId}/{allPaths=**} {
      allow read, write, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Mapas de Campanha compartilhados na partida
    match /campaign_maps/{campaignId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Monstros e NPCs
    match /npcs/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /monsters/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /mostro {
      allow read, write: if isAuthenticated();
    }
    match /mostro/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    match /monstro {
      allow read, write: if isAuthenticated();
    }
    match /monstro/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }

    // Fichas de heróis e personagens
    match /characters/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Avatares e perfis de usuários
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Documentos, PDFs e arquivos gerais de campanhas e notas
    match /documents/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /files/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Imagens de capa e assets visuais (img-capas)
    match /img-capas/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Library assets
    match /library/{category}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // Livros e regras canonicas
    match /livros/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }
  }
}

